{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kopit",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kopit",
      "database_id": "local-placeholder",
      "migrations_dir": "migrations"
    }
  ]
  // Nightly R2 backups are off (R2 needs a payment method). To turn them on, see README → Backups:
  // "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "kopit-backups" }],
  // "triggers": { "crons": ["0 19 * * *"] }  // 19:00 UTC = 03:00 Asia/Manila
}
