{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kopit",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // Smart Placement was tried and made requests from the Philippines run in San Jose (slower),
  // so the Worker runs at the nearest Cloudflare location (Hong Kong from PH) instead.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kopit",
      "database_id": "8f93ed49-e207-46a2-ae7d-592d6dcad279",
      "migrations_dir": "migrations"
    }
  ]
  // Nightly R2 backups are off (R2 needs a payment method). To turn them on, see CONTRIBUTING.md → Backups:
  // "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "kopit-backups" }],
  // "triggers": { "crons": ["0 19 * * *"] }  // 19:00 UTC = 03:00 Asia/Manila
}
